{% extends 'base.html' %}
{% block title %}Signup - Complete Registration{% endblock %}
{% block content %}

<form method="post">
  {% csrf_token %}
  <h3>Almost there!</h3>

  {% if user_type == "donor" %}
  <p class="text-muted">Click the button below to complete your registration</p>

  {% elif user_type == "volunteer" %}
    <label>Your Skills</label>
    <textarea name="skills" class="form-control"></textarea>
    <label>Availability</label>
    <input type="text" name="availability" class="form-control">

  {% elif user_type == "institution" %}
    <label>Organization Name</label>
    <input type="text" name="organization_name" class="form-control">
    <label>Registration Number</label>
    <input type="text" name="registration_number" class="form-control">
  {% endif %}

  <button type="submit" class="btn btn-success mt-3">Complete Registration</button>
</form>

{% endblock %}
