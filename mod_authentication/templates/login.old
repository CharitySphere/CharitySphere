{% extends 'base.html' %}

{% block content %}
  <h2>Login</h2>
  <form method="post">
    {% csrf_token %}
    {{ form.as_p }}
    <button type="submit">Login</button>
  </form>

  <p>Don't have an account?</p>
  <ul>
    <li>
      <a href="{% url 'register_donor' %}">Register as Donor</a>
    </li>
    <li>
      <a href="{% url 'register_volunteer' %}">Register as Volunteer</a>
    </li>
    <li>
      <a href="{% url 'register_institution' %}">Register as Institution</a>
    </li>
  </ul>
{% endblock %}
